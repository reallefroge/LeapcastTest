<Window x:Class="LeapcastStudioAI.SourcePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/leapcast.ico"
        Title="Source properties" Height="640" Width="500" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}">
  <DockPanel Margin="18,16,18,14">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="HeaderText" Text="Source" FontSize="20" FontWeight="Bold" Margin="3,0,0,2"/>
      <TextBlock x:Name="TypeText" Style="{StaticResource Hint}"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="OK" IsDefault="True" MinWidth="80" Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,6,8,0">
        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox"/>
        <TextBlock Text="Show / hide hotkey" Style="{StaticResource FieldLabel}"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Clear" Margin="6,0,0,0" Click="ClearHotkey_Click"/>
          <TextBox x:Name="HotkeyBox" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" ToolTip="Click here, then press the keys"/>
        </DockPanel>
        <TextBlock Text="Click the box, then press the keys. Copies in other scenes with the same hotkey toggle together."
                   Style="{StaticResource Hint}"/>

        <!-- Display -->
        <StackPanel x:Name="DisplayGroup">
          <TextBlock Text="Monitor" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="MonitorBox"/>
        </StackPanel>

        <!-- Window -->
        <StackPanel x:Name="WindowGroup">
          <TextBlock Text="Window" Style="{StaticResource FieldLabel}"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshWindows_Click"/>
            <ComboBox x:Name="WindowBox" IsEditable="True"/>
          </DockPanel>
          <TextBlock Text="Works in windowed and borderless mode. For exclusive fullscreen, use Display Capture."
                     Style="{StaticResource Hint}"/>
        </StackPanel>

        <!-- Display + window shared -->
        <StackPanel x:Name="CaptureGroup">
          <TextBlock Text="Capture method" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="MethodBox">
            <ComboBoxItem Content="GPU (recommended)" Tag="Auto"/>
            <ComboBoxItem Content="GDI (compatibility, 30 FPS max)" Tag="GDI"/>
          </ComboBox>
          <CheckBox x:Name="CursorBox" Content="Show mouse cursor"/>
          <TextBlock Text="Crop (px): left, top, right, bottom" Style="{StaticResource FieldLabel}"/>
          <UniformGrid Columns="4">
            <TextBox x:Name="CropL"/><TextBox x:Name="CropT"/><TextBox x:Name="CropR"/><TextBox x:Name="CropB"/>
          </UniformGrid>
          <TextBlock Text="Cropping costs nothing and saves bandwidth." Style="{StaticResource Hint}"/>
        </StackPanel>

        <!-- Camera -->
        <StackPanel x:Name="CameraGroup">
          <TextBlock Text="Camera" Style="{StaticResource FieldLabel}"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshCameras_Click"/>
            <ComboBox x:Name="CameraBox" IsEditable="True"/>
          </DockPanel>
          <TextBlock x:Name="CameraHint" Style="{StaticResource Hint}"/>
          <TextBlock Text="Camera resolution" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="CamResBox">
            <ComboBoxItem Content="Default" Tag="Default"/>
            <ComboBoxItem Content="640 × 480" Tag="640x480"/>
            <ComboBoxItem Content="1280 × 720 (recommended)" Tag="1280x720"/>
            <ComboBoxItem Content="1920 × 1080" Tag="1920x1080"/>
          </ComboBox>
          <TextBlock Text="Camera frame rate" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="CamFpsBox">
            <ComboBoxItem Content="Default" Tag="0"/>
            <ComboBoxItem Content="15" Tag="15"/>
            <ComboBoxItem Content="24" Tag="24"/>
            <ComboBoxItem Content="30 (recommended)" Tag="30"/>
            <ComboBoxItem Content="60" Tag="60"/>
          </ComboBox>
          <CheckBox x:Name="DenoiseBox" Content="Denoise (saves bandwidth in low light)"/>
          <CheckBox x:Name="MirrorBox" Content="Mirror"/>
          <TextBlock Text="Sync offset (ms)" Style="{StaticResource FieldLabel}"/>
          <DockPanel>
            <Button x:Name="ClapButton" DockPanel.Dock="Right" Content="Sync automatically (clap test)" Click="ClapTest_Click"/>
            <TextBox x:Name="SyncOffsetBox"/>
          </DockPanel>
          <TextBlock x:Name="ClapHint" Text="Webcams lag behind audio. Run the clap test and clap 4–5 times in view to measure it."
                     Style="{StaticResource Hint}"/>
        </StackPanel>

        <!-- Image -->
        <StackPanel x:Name="ImageGroup">
          <TextBlock Text="Image file" Style="{StaticResource FieldLabel}"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseImage_Click"/>
            <TextBox x:Name="ImageBox"/>
          </DockPanel>
        </StackPanel>

        <!-- Browser -->
        <StackPanel x:Name="BrowserGroup">
          <TextBlock Text="Web address (URL)" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="UrlBox"/>
          <TextBlock Text="A pop-out chat or overlay URL, or a local .html file."
                     Style="{StaticResource Hint}"/>
          <UniformGrid Columns="3">
            <StackPanel>
              <TextBlock Text="Width (px)" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="BrowserWBox"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Height (px)" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="BrowserHBox"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Frame rate" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="BrowserFpsBox">
                <ComboBoxItem Content="10 (chat)" Tag="10"/>
                <ComboBoxItem Content="15" Tag="15"/>
                <ComboBoxItem Content="30 (animated alerts)" Tag="30"/>
              </ComboBox>
            </StackPanel>
          </UniformGrid>
          <TextBlock Text="Custom CSS" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="CssBox" AcceptsReturn="True" MinHeight="54" TextWrapping="Wrap" FontFamily="Consolas"/>
          <TextBlock Text="Transparent background by default."
                     Style="{StaticResource Hint}"/>
        </StackPanel>

        <!-- Text -->
        <StackPanel x:Name="TextGroup">
          <TextBlock Text="Text" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="TextContentBox" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap"/>
          <UniformGrid Columns="2">
            <StackPanel>
              <TextBlock Text="Size (at 1080p)" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="FontSizeBox"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Colour (#RRGGBB)" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="ColorBox"/>
            </StackPanel>
          </UniformGrid>
        </StackPanel>

        <!-- Placement (all video) -->
        <StackPanel x:Name="PlacementGroup">
          <TextBlock Text="Position" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="AnchorBox"/>
          <StackPanel x:Name="FillGroup">
            <TextBlock Text="When it fills the screen" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="FillBox">
              <ComboBoxItem Content="Fill: crop to fit (recommended)" Tag="Crop"/>
              <ComboBoxItem Content="Fit: letterbox" Tag="Fit"/>
              <ComboBoxItem Content="Stretch" Tag="Stretch"/>
            </ComboBox>
            <TextBlock Text="An 800×500 window fills 16:9 by cropping about 5% from the top and bottom."
                       Style="{StaticResource Hint}"/>
          </StackPanel>
          <TextBlock x:Name="SizeLabel" Text="Width (% of the stream width)" Style="{StaticResource FieldLabel}"/>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" x:Name="SizeValue" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider x:Name="SizeSlider" Minimum="5" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SizeSlider_ValueChanged" Margin="3,6"/>
          </DockPanel>
          <TextBlock Text="Margin from the edge (pixels)" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="MarginBox"/>
        </StackPanel>

        <!-- Audio -->
        <StackPanel x:Name="AudioGroup">
          <TextBlock Text="Device" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="AudioDeviceBox"/>
          <TextBlock Text="Volume (dB, 0 = unchanged)" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="VolumeBox"/>
          <CheckBox x:Name="NoiseBox" Content="Noise suppression"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
