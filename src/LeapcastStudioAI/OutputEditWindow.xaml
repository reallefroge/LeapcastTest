<Window x:Class="LeapcastStudioAI.OutputEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Output" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
  <StackPanel Margin="18,16,18,14">
    <TextBlock x:Name="HeaderText" Text="Add output" FontSize="20" FontWeight="Bold" Margin="3,0,0,8"/>

    <TextBlock Text="Service" Style="{StaticResource FieldLabel}"/>
    <ComboBox x:Name="ServiceBox" SelectionChanged="ServiceBox_SelectionChanged"/>

    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="NameBox"/>

    <TextBlock Text="Server URL" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="ServerBox"/>

    <TextBlock Text="Stream key" Style="{StaticResource FieldLabel}"/>
    <PasswordBox x:Name="KeyBox"/>
    <TextBlock x:Name="KeyHint" Style="{StaticResource Hint}"/>
    <CheckBox x:Name="AskKeyBox" Content="Ask for a fresh key every time this output starts"/>
    <TextBlock Text="Keys are stored encrypted for your Windows account only." Style="{StaticResource Hint}"/>

    <TextBlock Text="Canvas" Style="{StaticResource FieldLabel}"/>
    <ComboBox x:Name="CanvasBox">
      <ComboBoxItem Content="Horizontal 16:9 (Twitch, YouTube, Kick)" Tag="Horizontal"/>
      <ComboBoxItem Content="Vertical 9:16 (TikTok, Shorts, Reels)" Tag="Vertical"/>
    </ComboBox>

    <TextBlock Text="Encoding" Style="{StaticResource FieldLabel}"/>
    <ComboBox x:Name="EncodeBox" SelectionChanged="EncodeBox_SelectionChanged">
      <ComboBoxItem Content="Share the canvas encode (recommended: no extra GPU/CPU)" Tag="Shared"/>
      <ComboBoxItem Content="Own encode with its own bitrate" Tag="Own"/>
    </ComboBox>
    <StackPanel x:Name="OwnPanel" Margin="12,0,0,0">
      <TextBlock Text="Bitrate for this output (kbps)" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="OwnBitrateBox"/>
      <TextBlock Text="Only needed when one platform needs a different bitrate than the others (e.g. YouTube at 9000 while Twitch is capped at 6000). Costs a second encode."
                 Style="{StaticResource Hint}"/>
    </StackPanel>

    <CheckBox x:Name="EnabledBox" Content="Include in &quot;Go live&quot; / Start all"/>

    <DockPanel Margin="0,14,0,0">
      <Button x:Name="DeleteButton" DockPanel.Dock="Left" Content="Delete output" Click="Delete_Click" Foreground="{StaticResource BadBrush}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True"/>
        <Button Content="Save" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>
