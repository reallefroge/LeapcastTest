<Window x:Class="LeapcastStudioAI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/leapcast.ico"
        Title="Studio settings" Height="760" Width="660" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}">
  <DockPanel Margin="18,16,18,14">
    <TextBlock DockPanel.Dock="Top" Text="Studio settings" FontSize="22" FontWeight="Bold" Margin="3,0,0,6"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Save settings" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
    </StackPanel>
    <TabControl x:Name="Tabs">
      <TabItem Header="Stream" Tag="Stream">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border Style="{StaticResource Card}" Margin="0,4,8,0">
            <StackPanel>
            <TextBlock Text="What are you streaming?" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="ContentBox" SelectionChanged="AnyChanged">
              <ComboBoxItem Content="Low motion (Wizard101, card and turn-based games)" Tag="LowMotion"/>
              <ComboBoxItem Content="High motion (shooters, racing, action)" Tag="HighMotion"/>
            </ComboBox>
            <TextBlock Text="Quality profile" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="ProfileBox" SelectionChanged="AnyChanged">
              <ComboBoxItem Content="Auto (recommended)" Tag="Auto"/>
              <ComboBoxItem Content="Data saver: 720p, very low upload" Tag="DataSaver"/>
              <ComboBoxItem Content="Balanced: 900p" Tag="Balanced"/>
              <ComboBoxItem Content="High quality: 1080p" Tag="High"/>
              <ComboBoxItem Content="Custom" Tag="Custom"/>
            </ComboBox>
            <StackPanel x:Name="CustomPanel" Margin="12,0,0,0">
              <TextBlock Text="Resolution" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="ResolutionBox" IsEditable="True" SelectionChanged="AnyChanged" LostFocus="AnyChanged">
                <ComboBoxItem Content="1920 × 1080"/>
                <ComboBoxItem Content="1664 × 936"/>
                <ComboBoxItem Content="1600 × 900"/>
                <ComboBoxItem Content="1280 × 720"/>
                <ComboBoxItem Content="960 × 540"/>
                <ComboBoxItem Content="2560 × 1440"/>
              </ComboBox>
              <TextBlock Text="Frame rate" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="FrameRateBox" SelectionChanged="AnyChanged">
                <ComboBoxItem Content="30 FPS" Tag="30"/>
                <ComboBoxItem Content="60 FPS" Tag="60"/>
              </ComboBox>
              <TextBlock Text="Maximum bitrate (kbps)" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="BitrateBox" TextChanged="AnyChanged"/>
            </StackPanel>
            <TextBlock Text="Encoder" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="EncoderBox" SelectionChanged="AnyChanged"/>
            <TextBlock Text="Encoder preset" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="PresetBox" SelectionChanged="AnyChanged">
              <ComboBoxItem Content="Quality" Tag="Quality"/>
              <ComboBoxItem Content="Balanced (recommended)" Tag="Balanced"/>
              <ComboBoxItem Content="Performance" Tag="Performance"/>
            </ComboBox>
            <TextBlock Text="Bitrate mode" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="RateBox" SelectionChanged="AnyChanged">
              <ComboBoxItem Content="Smart VBR (recommended)" Tag="SmartVbr"/>
              <ComboBoxItem Content="CBR" Tag="Cbr"/>
            </ComboBox>
            <TextBlock Text="Audio quality" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="AudioBox" SelectionChanged="AnyChanged">
              <ComboBoxItem Content="96 kbps (data saver)" Tag="96"/>
              <ComboBoxItem Content="128 kbps" Tag="128"/>
              <ComboBoxItem Content="160 kbps (recommended)" Tag="160"/>
              <ComboBoxItem Content="192 kbps" Tag="192"/>
            </ComboBox>
            <CheckBox x:Name="LowLatencyBox" Content="Low latency" Click="AnyChanged"/>
            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="10" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Text="You'll stream" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock x:Name="PlanPreview" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,4"/>
                <TextBlock x:Name="PlanReasons" Style="{StaticResource Hint}" Margin="0"/>
              </StackPanel>
            </Border>
          
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Hotkeys" Tag="Hotkeys">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border Style="{StaticResource Card}" Margin="0,4,8,0">
            <StackPanel>
              <TextBlock Text="Click a box, then press the keys. Backspace clears it. Hotkeys work while the game has focus."
                         Style="{StaticResource Hint}" Margin="3,0,3,8"/>
              <StackPanel x:Name="HotkeysPanel"/>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Canvas &amp; scenes" Tag="Canvas">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border Style="{StaticResource Card}" Margin="0,4,8,0">
            <StackPanel>
            <TextBlock Text="VERTICAL CANVAS" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="VerticalBox" Content="Enable 9:16 canvas" Click="AnyChanged"/>
            <TextBlock Text="Vertical resolution" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="VerticalResBox" SelectionChanged="AnyChanged">
              <ComboBoxItem Content="720 × 1280 (recommended)" Tag="720x1280"/>
              <ComboBoxItem Content="1080 × 1920" Tag="1080x1920"/>
            </ComboBox>
            <TextBlock Text="Vertical bitrate (kbps, 0 = automatic)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="VerticalBitrateBox" TextChanged="AnyChanged"/>
            <TextBlock Text="Camera on top, game below by default. Drag on the vertical preview to adjust."
                       Style="{StaticResource Hint}"/>
            <TextBlock Text="SCENE TRANSITIONS" Style="{StaticResource SectionHeader}" Margin="3,16,3,4"/>
            <TextBlock Text="Transition" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="TransitionBox">
              <ComboBoxItem Content="Fade (crossfade between scenes)" Tag="Fade"/>
              <ComboBoxItem Content="Cut (instant)" Tag="Cut"/>
            </ComboBox>
            <TextBlock Text="Fade length" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="TransitionMsBox">
              <ComboBoxItem Content="0.3 s" Tag="300"/>
              <ComboBoxItem Content="0.5 s" Tag="500"/>
              <ComboBoxItem Content="0.8 s" Tag="800"/>
              <ComboBoxItem Content="1 s" Tag="1000"/>
              <ComboBoxItem Content="1.5 s" Tag="1500"/>
            </ComboBox>
            <TextBlock Text="All scenes stay loaded, so switching is instant. Each scene adds some CPU load."
                       Style="{StaticResource Hint}"/>
          
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Connection" Tag="Connection">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border Style="{StaticResource Card}" Margin="0,4,8,0">
            <StackPanel>
            <TextBlock Text="Upload speed (kbps)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="UploadBox" TextChanged="AnyChanged"/>
            <TextBlock Text="In kbps (12 Mbps = 12000). Auto quality stays within 75% of it. Each destination uploads the full bitrate."
                       Style="{StaticResource Hint}"/>
            <DockPanel Margin="0,8,0,0">
              <Button x:Name="TestButton" DockPanel.Dock="Left" Content="Test my connection" Click="Test_Click"/>
              <TextBlock x:Name="TestResult" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0,0,0"
                         Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </DockPanel>
            <TextBlock Text="RELIABILITY" Style="{StaticResource SectionHeader}" Margin="3,16,3,4"/>
            <CheckBox x:Name="ReconnectBox" Content="Reconnect automatically"/>
            <CheckBox x:Name="AdjustBox" Content="Lower bitrate when the connection struggles"/>
            <CheckBox x:Name="AdaptBox" Content="Use lighter settings when the PC is overloaded"/>
          
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Recording" Tag="Recording">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border Style="{StaticResource Card}" Margin="0,4,8,0">
            <StackPanel>
            <TextBlock Text="Save to folder" Style="{StaticResource FieldLabel}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseFolder_Click"/>
              <TextBox x:Name="FolderBox"/>
            </DockPanel>
            <TextBlock Text="Replay length" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="ReplayBox">
              <ComboBoxItem Content="15 seconds" Tag="15"/>
              <ComboBoxItem Content="30 seconds" Tag="30"/>
              <ComboBoxItem Content="60 seconds" Tag="60"/>
              <ComboBoxItem Content="2 minutes" Tag="120"/>
              <ComboBoxItem Content="5 minutes" Tag="300"/>
            </ComboBox>
            <TextBlock Text="Recording uses the stream's encode, so it adds no GPU/CPU load."
                       Style="{StaticResource Hint}"/>
            <Button Content="Open the folder" HorizontalAlignment="Left" Click="OpenRecordings_Click" Margin="3,8,3,3"/>
            <TextBlock Text="VOICE CLIPS" Style="{StaticResource SectionHeader}" Margin="3,16,3,4"/>
            <CheckBox x:Name="VoiceClipBox" Content="Save a clip when I say the word"
                      Checked="VoiceClipBox_Changed" Unchecked="VoiceClipBox_Changed"/>
            <TextBlock Text="Applies immediately. Clips are taken while you're live (or recording)."
                       Style="{StaticResource Hint}"/>
            <Grid Margin="0,2,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Word" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="VoiceWordBox"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Clip length (15–60 seconds)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="VoiceSecondsBox" TextChanged="VoiceSecondsBox_TextChanged"/>
                <TextBlock x:Name="VoiceSecondsHint" Style="{StaticResource Hint}" Visibility="Collapsed"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="Sensitivity" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="VoiceSensitivityBox">
              <ComboBoxItem Content="Normal" Tag="Normal"/>
              <ComboBoxItem Content="High (recommended)" Tag="High"/>
              <ComboBoxItem Content="Maximum (more false triggers)" Tag="Max"/>
            </ComboBox>
            <TextBlock Text="Save voice clips to" Style="{StaticResource FieldLabel}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseClipFolder_Click"/>
              <TextBox x:Name="VoiceFolderBox"/>
            </DockPanel>
            <TextBlock Text="Named by date and time (2026-11-04 15-57-32.mp4). Speech recognition runs on this PC."
                       Style="{StaticResource Hint}"/>

            <TextBlock Text="9:16 CLIPS (TIKTOK, SHORTS)" Style="{StaticResource SectionHeader}" Margin="3,16,3,8"/>
            <CheckBox x:Name="VerticalClipsBox" Content="Save clips as 9:16 (TikTok / Shorts)"/>
            <TextBlock Text="A small camera at the top, the game big below it, blurred game behind. Only the 9:16 file is kept (off: 16:9 clips)."
                       Style="{StaticResource Hint}"/>
            <CheckBox x:Name="ClipCaptionsBox" Content="Captions on clips (what you say)" Margin="0,8,0,0"/>
            <TextBlock Text="Your mic is transcribed on this PC while clips can be taken; the words said during a clip are burned into it as captions."
                       Style="{StaticResource Hint}"/>
            <TextBlock Text="Text at the bottom (optional)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ClipHandleBox"/>

            <TextBlock Text="WIZARD101" Style="{StaticResource SectionHeader}" Margin="3,16,3,8"/>
            <CheckBox x:Name="DeathClipsBox" Content="Save the fight when my HP hits 0"/>
            <TextBlock Text="Watches the red health globe. When it empties, saves from the start of the fight (up to 5 minutes) to just after the death, named &quot;… death.mp4&quot;."
                       Style="{StaticResource Hint}"/>

            <TextBlock Text="CHAT CLIPS (TWITCH)" Style="{StaticResource SectionHeader}" Margin="3,16,3,8"/>
            <CheckBox x:Name="ChatClipsBox" Content="Clip when someone types the command in chat"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Command" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ChatCommandBox"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Who can use it" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="ChatWhoBox">
                  <ComboBoxItem Content="Me and mods" Tag="Mods"/>
                  <ComboBoxItem Content="Me, mods and VIPs" Tag="ModsAndVips"/>
                  <ComboBoxItem Content="Everyone" Tag="Everyone"/>
                </ComboBox>
              </StackPanel>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Twitch channel (empty = from your chat source)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ChatChannelBox"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Viewer delay (seconds)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ChatDelayBox"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="Reads chat anonymously (no login). Viewers see the stream a few seconds late, so the clip ends that much before their message."
                       Style="{StaticResource Hint}"/>

            <TextBlock Text="STREAM RECAP" Style="{StaticResource SectionHeader}" Margin="3,16,3,8"/>
            <CheckBox x:Name="RecapBox" Content="When a stream ends, build a recap of its clips"/>
            <TextBlock Text="A &quot;Recap&quot; folder in your clips folder: the stream's clips, a highlight reel with title and outro cards, and a thumbnail from each clip."
                       Style="{StaticResource Hint}"/>
            <TextBlock Text="Title card" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="RecapTitleBox"/>
            <TextBlock Text="Outro card: your socials, one per line" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="RecapSocialsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalContentAlignment="Top"/>
          
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Advanced" Tag="Advanced">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border Style="{StaticResource Card}" Margin="0,4,8,0">
            <StackPanel>
            <TextBlock Text="PERFORMANCE" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="InstantSwitchBox" Content="Instant scene switching"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Keeps every scene and hidden source running, so switching and showing are instant. Uses more CPU and RAM. Off (light mode): only what's on screen is captured; a switch takes about a second, and destinations stay connected."/>
            <TextBlock Text="FFMPEG" Style="{StaticResource SectionHeader}" Margin="3,14,3,8"/>
            <TextBlock Text="FFmpeg path (empty = bundled)" Style="{StaticResource FieldLabel}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseFfmpeg_Click"/>
              <TextBox x:Name="FfmpegBox"/>
            </DockPanel>
            <Button Content="Open log folder" HorizontalAlignment="Left" Click="OpenLogs_Click" Margin="3,8,3,3"/>
          
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
