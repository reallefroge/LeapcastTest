<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LeapcastStudioAI</RootNamespace>
    <AssemblyName>Leapcast Studio AI</AssemblyName>
    <Version>0.25.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe / taskbar / Start menu icon (source art: Assets/leapcast.svg, leapcast-small.svg for 16–32 px) -->
    <ApplicationIcon>Assets\leapcast.ico</ApplicationIcon>
    <!-- the GPU canvas copies pictures to and from Direct3D textures -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\leapcast.ico" />
    <Resource Include="Assets\leapcast-64.png" />
    <!-- the video editor's fonts (Cinzel, Cinzel Decorative: SIL Open Font License), handed to libass -->
    <None Include="Assets\Fonts\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Assets\Fonts" />
  </ItemGroup>
  <ItemGroup>
    <!-- WASAPI mic + desktop (loopback) audio capture -->
    <!-- GPU scene compositing (Direct3D 11) -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.1" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <!-- the VOD editor's camera background removal (a person segmentation model, run on the processor) -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- DPAPI encryption for the stream key -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Browser sources (chat, alerts): Microsoft Edge WebView2 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- Voice clips ("Clip"): Vosk offline speech recognition (libvosk.dll; Core/VoskApi.cs calls it directly, so the
         managed wrapper isn't referenced). The model is added to the app folder by scripts/build-installer.ps1. -->
    <PackageReference Include="Vosk" Version="0.3.38" ExcludeAssets="compile" />
    <!-- Dockable panels: drag to rearrange, pop out into their own windows, layout saved (like OBS docks) -->
    <PackageReference Include="Dirkster.AvalonDock" Version="4.72.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.72.1" />
  </ItemGroup>
</Project>
