<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LeapcastStudioAI</RootNamespace>
    <AssemblyName>Leapcast Studio AI</AssemblyName>
    <Version>0.9.8</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe / taskbar / Start menu icon (source art: Assets/leapcast.svg, leapcast-small.svg for 16–32 px) -->
    <ApplicationIcon>Assets\leapcast.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\leapcast.ico" />
    <Resource Include="Assets\leapcast-64.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- WASAPI mic + desktop (loopback) audio capture -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- DPAPI encryption for the stream key -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Browser sources (chat, alerts): Microsoft Edge WebView2 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- Voice clips ("Clip"): Vosk offline speech recognition (libvosk.dll; Core/VoskApi.cs calls it directly, so the
         managed wrapper isn't referenced). The model is added to the app folder by scripts/build-installer.ps1. -->
    <PackageReference Include="Vosk" Version="0.3.38" ExcludeAssets="compile" />
  </ItemGroup>
</Project>
