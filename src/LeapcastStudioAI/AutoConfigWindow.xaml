<Window x:Class="LeapcastStudioAI.AutoConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/leapcast.ico"
        Title="Auto-config wizard" Width="600" Height="640" MinHeight="520" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}">
  <DockPanel Margin="20,16,20,14">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Auto-config" FontSize="22" FontWeight="Bold" Margin="3,0,0,2"/>
      <TextBlock x:Name="Subtitle" Text="Tests this PC and picks the highest settings it can sustain."
                 Style="{StaticResource Hint}" Margin="3,0,3,8"/>
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button x:Name="CancelButton" DockPanel.Dock="Left" Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ClapButton" Content="Sync camera (clap test)" Click="Clap_Click" Visibility="Collapsed"/>
        <Button x:Name="PrimaryButton" Content="Start" Style="{StaticResource PrimaryButton}" MinWidth="120" Click="Primary_Click"/>
      </StackPanel>
    </DockPanel>
    <Grid>
      <!-- Page 1: questions -->
      <ScrollViewer x:Name="QuestionsPage" VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="What do you stream?" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="ContentBox">
              <ComboBoxItem Content="Low motion (Wizard101, card and turn-based games)" Tag="LowMotion"/>
              <ComboBoxItem Content="High motion (shooters, racing, action)" Tag="HighMotion"/>
            </ComboBox>
            <TextBlock Text="What matters most?" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="PriorityBox">
              <ComboBoxItem Content="Performance: lowest PC load (recommended)" Tag="Performance"/>
              <ComboBoxItem Content="Quality: sharpest picture this PC can sustain" Tag="Quality"/>
            </ComboBox>
            <TextBlock Text="Upload speed (kbps)" Style="{StaticResource FieldLabel}"/>
            <DockPanel>
              <Button x:Name="ScanButton" DockPanel.Dock="Right" Content="Scan my upload" Click="Scan_Click" Margin="6,0,0,0"
                      ToolTip="Measures upload speed (about 10 s)"/>
              <TextBox x:Name="UploadBox"/>
            </DockPanel>
            <CheckBox x:Name="ScanBox" Content="Measure upload speed first (about 10 s)"/>
            <TextBlock x:Name="UploadHint" Text="In kbps (12 Mbps = 12000). Scan uses Twitch's bandwidth test when a Twitch key is set."
                       Style="{StaticResource Hint}"/>
            <CheckBox x:Name="FillGameBox" Content="Fill the 16:9 canvas with the game (crop edges, no black bars)" IsChecked="True"/>
            <TextBlock Text="Each test runs your scene for about 15 seconds. Keep the game running. Nothing is streamed."
                       Style="{StaticResource Hint}" Margin="3,10,3,0"/>
          </StackPanel>
        </Border>
      </ScrollViewer>
      <!-- Page 2: progress + results -->
      <ScrollViewer x:Name="ResultsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <ItemsControl x:Name="StepsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,3"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <Border x:Name="SummaryCard" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="RECOMMENDED" Style="{StaticResource SectionHeader}"/>
              <TextBlock x:Name="SummaryTitle" FontSize="16" FontWeight="SemiBold" Margin="3,0,3,4" TextWrapping="Wrap"/>
              <ItemsControl x:Name="SummaryList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat='•  {0}'}" Style="{StaticResource Hint}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
