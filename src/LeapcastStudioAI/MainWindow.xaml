<Window x:Class="LeapcastStudioAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LeapcastStudioAI"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:adt="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        Icon="pack://application:,,,/Assets/leapcast.ico"
        Title="Leapcast Studio AI" Height="900" Width="1520" MinHeight="600" MinWidth="980"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <!-- One multistream output row: status dot, name, live details, start/stop, edit -->
    <DataTemplate x:Key="OutputRowTemplate">
      <Border Background="#0DFFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="10,7" Margin="0,3">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" Click="EditOutput_Click" Tag="{Binding Id}" ToolTip="Edit output"/>
          <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Background="{Binding ActionBrush}" Click="ToggleOutput_Click"
                  Tag="{Binding Id}" MinWidth="72" Padding="8,5" FontSize="12"/>
          <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding DotBrush}" Margin="2,0,9,0" VerticalAlignment="Center"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ===================== Menu bar + top bar ===================== -->
    <StackPanel Grid.Row="0">
    <Menu x:Name="MainMenu" Padding="10,3,10,1" Background="#990E1220" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <MenuItem Header="_Settings">
        <MenuItem Header="Stream…" Click="SettingsMenu_Click" Tag="Stream"/>
        <MenuItem Header="Hotkeys…" Click="SettingsMenu_Click" Tag="Hotkeys"/>
        <MenuItem Header="Recording…" Click="SettingsMenu_Click" Tag="Recording"/>
        <MenuItem Header="Canvas &amp; scenes…" Click="SettingsMenu_Click" Tag="Canvas"/>
        <MenuItem Header="Connection…" Click="SettingsMenu_Click" Tag="Connection"/>
        <MenuItem Header="Stream safety (delay, slur filter, codes)…" Click="SettingsMenu_Click" Tag="Safety"/>
        <MenuItem Header="Advanced…" Click="SettingsMenu_Click" Tag="Advanced"/>
      </MenuItem>
      <MenuItem x:Name="DocksMenu" Header="_Docks" SubmenuOpened="DocksMenu_SubmenuOpened">
        <MenuItem Header="Scenes" IsCheckable="True" Click="DockToggle_Click" Tag="Scenes"/>
        <MenuItem Header="Sources" IsCheckable="True" Click="DockToggle_Click" Tag="Sources"/>
        <MenuItem Header="Controls" IsCheckable="True" Click="DockToggle_Click" Tag="Controls"/>
        <MenuItem Header="Audio mixer" IsCheckable="True" Click="DockToggle_Click" Tag="Mixer"/>
        <MenuItem Header="Timer" IsCheckable="True" Click="DockToggle_Click" Tag="Timer"/>
        <MenuItem Header="Multistream" IsCheckable="True" Click="DockToggle_Click" Tag="Multistream"/>
        <MenuItem Header="Stats" IsCheckable="True" Click="DockToggle_Click" Tag="SmartStream"/>
        <MenuItem Header="Activity" IsCheckable="True" Click="DockToggle_Click" Tag="Activity"/>
        <MenuItem Header="Stream info (Twitch / YouTube)" IsCheckable="True" Click="DockToggle_Click" Tag="StreamInfo"/>
        <MenuItem Header="Go live button" IsCheckable="True" Click="DockToggle_Click" Tag="GoLive"/>
        <MenuItem Header="Studio mode button" IsCheckable="True" Click="DockToggle_Click" Tag="StudioButton"/>
        <Separator/>
        <MenuItem Header="Show all docks" Click="ResetDocks_Click"/>
        <MenuItem Header="Reset layout" Click="ResetLayout_Click" ToolTip="Put every panel back where it started"/>
      </MenuItem>
      <MenuItem x:Name="ProfileMenu" Header="_Profile" SubmenuOpened="ProfileMenu_SubmenuOpened">
        <MenuItem Header="(profiles)"/>
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem x:Name="AutoConfigMenu" Header="Auto-configuration wizard…" Click="AutoConfig_Click"/>
        <MenuItem Header="Edit a recording into a video…" Click="VodEdit_Click" ToolTip="Turns an hour or more of stream into an edited ~15-minute video"/>
        <MenuItem Header="Stream settings…" Click="SettingsMenu_Click" Tag="Stream"/>
        <MenuItem Header="Stream safety…" Click="SettingsMenu_Click" Tag="Safety" ToolTip="Safety delay, slur filter, game codes, loud-audio protection"/>
        <MenuItem Header="Add destination…" Click="AddOutput_Click"/>
        <MenuItem Header="Connection test…" Click="SettingsMenu_Click" Tag="Connection"/>
        <Separator/>
        <MenuItem x:Name="StudioModeMenu" Header="Studio mode" IsCheckable="True" Click="StudioMode_Click"/>
        <Separator/>
        <MenuItem Header="Open recordings folder" Click="OpenRecordings_Click"/>
        <MenuItem Header="Open log folder" Click="OpenLogs_Click"/>
      </MenuItem>
    </Menu>
    <Border Background="#990E1220" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="pack://application:,,,/Assets/leapcast-64.png" Width="28" Height="28" Margin="0,0,9,0" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="LEAPCAST" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock Text="STUDIO AI" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AccentGradient}" Margin="6,0,0,0" VerticalAlignment="Center"/>
          <Border x:Name="EngineBadge" Background="#332F26" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="10,3" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="EngineBadgeText" Text="STARTING ENGINE…" Foreground="{StaticResource WarnBrush}" FontSize="11" FontWeight="SemiBold"/>
          </Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="LiveTag" Background="{StaticResource LiveBrush}" CornerRadius="11" Padding="11,4" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock x:Name="LiveTagText" Text="LIVE" FontWeight="Bold" FontSize="12"/>
          </Border>
          <Border x:Name="VoiceTag" Background="#1A3DD6F5" BorderBrush="#553DD6F5" BorderThickness="1" CornerRadius="11" Padding="11,4" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center"
                  ToolTip="Voice clips on (Settings → Recording)">
            <TextBlock x:Name="VoiceTagText" Text="🎙 Say “Clip”" FontWeight="SemiBold" FontSize="12" Foreground="#9FE8FF"/>
          </Border>
          <Border x:Name="SafetyTag" Background="#1A7CF5A0" BorderBrush="#557CF5A0" BorderThickness="1" CornerRadius="11" Padding="11,4" Margin="0,0,6,0"
                  Visibility="Collapsed" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="SafetyTag_Click"
                  ToolTip="Stream safety delay on: desktop audio is checked for slurs before it goes out. Click for the settings.">
            <TextBlock x:Name="SafetyTagText" Text="🛡 2 s delay" FontWeight="SemiBold" FontSize="12" Foreground="#A8F5C8"/>
          </Border>
          <Border x:Name="RecTag" Background="#7A2E31" CornerRadius="11" Padding="11,4" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock x:Name="RecTagText" Text="● REC" FontWeight="Bold" FontSize="12"/>
          </Border>
          <Button x:Name="StudioModeButton" Content="Studio mode" Click="StudioMode_Click" Padding="12,8" Margin="0,0,6,0"
                  ToolTip="Edit the next scene beside the live one"/>
          <Button x:Name="GoLiveButton" Style="{StaticResource PrimaryButton}" Content="▶  Go live" Click="GoLive_Click" Padding="18,8" MinWidth="130"
                  ToolTip="Start all enabled destinations"/>
        </StackPanel>
      </DockPanel>
    </Border>
    </StackPanel>

    <!-- ===================== Body: dockable panels (drag a title to move, pop out, or dock elsewhere) ===================== -->
    <ad:DockingManager x:Name="DockManager" Grid.Row="1" Margin="6,6,6,4" AllowMixedOrientation="True">
      <ad:DockingManager.Theme><adt:Vs2013DarkTheme/></ad:DockingManager.Theme>
      <ad:LayoutRoot>
        <ad:LayoutPanel Orientation="Horizontal">
          <ad:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="250">
            <ad:LayoutAnchorablePane DockHeight="2*">
              <ad:LayoutAnchorable ContentId="Scenes" Title="Scenes" CanClose="False" CanHide="True">
                  <Border x:Name="ScenesDock" Style="{StaticResource Card}">
                    <DockPanel>
                      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <Button Style="{StaticResource IconButton}" Content="&#xE710;" Click="AddScene_Click" ToolTip="Add scene (copies the current one)"/>
                          <Button Style="{StaticResource IconButton}" Content="&#xE8AC;" Click="RenameScene_Click" ToolTip="Rename scene"/>
                          <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="DeleteScene_Click" ToolTip="Delete scene"/>
                        </StackPanel>
                      </DockPanel>
                      <TextBlock DockPanel.Dock="Bottom" Text="Click a scene to switch." Style="{StaticResource Hint}"/>
                      <ListBox x:Name="ScenesList" SelectionChanged="ScenesList_SelectionChanged" Background="Transparent" BorderThickness="0"
                               Foreground="{StaticResource TextBrush}" DisplayMemberPath="Name"/>
                    </DockPanel>
                  </Border>
              </ad:LayoutAnchorable>
            </ad:LayoutAnchorablePane>
            <ad:LayoutAnchorablePane DockHeight="3*">
              <ad:LayoutAnchorable ContentId="Sources" Title="Sources" CanClose="False" CanHide="True">
                  <Border x:Name="SourcesDock" Style="{StaticResource Card}">
                    <DockPanel>
                      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <StackPanel.Resources>
                            <!-- six buttons: compact, so the title still fits in a narrow column -->
                            <Style x:Key="CompactIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
                              <Setter Property="Padding" Value="3,6"/>
                              <Setter Property="Margin" Value="0"/>
                              <Setter Property="MinWidth" Value="22"/>
                            </Style>
                          </StackPanel.Resources>
                          <Button Style="{StaticResource CompactIcon}" Content="&#xE710;" Click="AddSource_Click" ToolTip="Add source"/>
                          <Button Style="{StaticResource CompactIcon}" Content="&#xE713;" Click="SourceProperties_Click" ToolTip="Properties"/>
                          <Button Style="{StaticResource CompactIcon}" Content="&#xF0E2;" Click="MultiClient_Click" ToolTip="Multi-client: show every open game client side by side (select a window source first, or it uses Wizard101)"/>
                          <Button Style="{StaticResource CompactIcon}" Content="&#xE8B7;" Click="AddFolder_Click" ToolTip="New folder"/>
                          <Button Style="{StaticResource CompactIcon}" Content="&#xE70E;" Click="MoveSourceUp_Click" ToolTip="Move up"/>
                          <Button Style="{StaticResource CompactIcon}" Content="&#xE70D;" Click="MoveSourceDown_Click" ToolTip="Move down"/>
                          <Button Style="{StaticResource CompactIcon}" Content="&#xE74D;" Click="RemoveSource_Click" ToolTip="Remove source"/>
                        </StackPanel>
                      </DockPanel>
                      <TextBlock DockPanel.Dock="Bottom" Text="Top of the list is in front. Drag to reorder." Style="{StaticResource Hint}"/>
                      <ListBox x:Name="SourcesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" AllowDrop="True"
                               MouseDoubleClick="SourcesList_MouseDoubleClick" SelectionChanged="SourcesList_SelectionChanged"
                               PreviewMouseLeftButtonDown="SourcesList_PreviewMouseLeftButtonDown" PreviewMouseMove="SourcesList_PreviewMouseMove"
                               DragOver="SourcesList_DragOver" Drop="SourcesList_Drop" MouseRightButtonUp="SourcesList_MouseRightButtonUp">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <DockPanel>
                              <Border DockPanel.Dock="Left" Width="{Binding ListIndent}"/>
                              <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding Visible}" Click="SourceVisible_Click" Style="{StaticResource EyeToggle}"
                                            VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="Show / hide"/>
                              <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding Locked}" Click="SourceLock_Click" Style="{StaticResource LockToggle}"
                                            VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Lock position and size"/>
                              <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding Collapsed}" Click="FolderCollapse_Click" VerticalAlignment="Center"
                                            ToolTip="Show / hide contents">
                                <ToggleButton.Style>
                                  <Style TargetType="ToggleButton" BasedOn="{StaticResource ChevronToggle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsFolder}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </ToggleButton.Style>
                              </ToggleButton>
                              <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center"
                                         Foreground="{StaticResource TextBrush}" Margin="2,0,7,0" Style="{StaticResource FolderOnly}"/>
                              <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ListDetail}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                              </StackPanel>
                            </DockPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </DockPanel>
                  </Border>
              </ad:LayoutAnchorable>
            </ad:LayoutAnchorablePane>
          </ad:LayoutAnchorablePaneGroup>
          <ad:LayoutPanel Orientation="Vertical">
            <ad:LayoutDocumentPane>
              <ad:LayoutDocument ContentId="Canvas" Title="Canvas" CanClose="False" CanFloat="False">
                <Border Background="#05060A" BorderBrush="{StaticResource CardEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition x:Name="StageColumn" Width="0"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="3.2*"/>
                      <ColumnDefinition x:Name="VerticalColumn" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <!-- Studio mode: the staged scene (editable) -->
                    <DockPanel x:Name="StagePanel" Grid.Column="0" Visibility="Collapsed">
                      <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                        <TextBlock x:Name="StageSceneLabel" DockPanel.Dock="Right" Text="" Foreground="#B9B0FF" FontSize="12" Margin="8,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="PREVIEW" Style="{StaticResource SectionHeader}" Margin="0" ToolTip="Changes here go live when you click Transition"/>
                      </DockPanel>
                      <Viewbox x:Name="SViewbox" Stretch="Uniform">
                        <Grid x:Name="SCanvasHost" Width="1600" Height="900" Background="#0E1016">
                          <Image x:Name="SPreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear"/>
                          <Canvas x:Name="SEditLayer" Background="Transparent" ClipToBounds="True"/>
                        </Grid>
                      </Viewbox>
                    </DockPanel>
                    <StackPanel x:Name="TransitionPanel" Grid.Column="1" VerticalAlignment="Center" Margin="10,0" Visibility="Collapsed" Width="118">
                      <Button x:Name="TransitionButton" Content="Transition ➜" Style="{StaticResource PrimaryButton}" Click="Transition_Click"
                              ToolTip="Send Preview to Program" Padding="8,9"/>
                      <ComboBox x:Name="TransitionKindBox" Margin="0,8,0,0" SelectionChanged="TransitionKind_SelectionChanged" ToolTip="How the scene switch looks">
                        <ComboBoxItem Content="Fade · 0.3 s" Tag="Fade|300"/>
                        <ComboBoxItem Content="Fade · 0.6 s" Tag="Fade|600"/>
                        <ComboBoxItem Content="Fade · 1 s" Tag="Fade|1000"/>
                        <ComboBoxItem Content="Fade · 2 s" Tag="Fade|2000"/>
                        <ComboBoxItem Content="Cut" Tag="Cut|0"/>
                      </ComboBox>
                    </StackPanel>
                    <!-- Horizontal canvas (Program in studio mode) -->
                    <DockPanel Grid.Column="2">
                      <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                        <TextBlock x:Name="SelectedSceneLabel" DockPanel.Dock="Right" Text="" Foreground="#BEB6FF" FontSize="12" Margin="8,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="HorizontalCaption" Text="HORIZONTAL · 16:9" Style="{StaticResource SectionHeader}" Margin="0" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                      <Grid>
                        <Viewbox x:Name="HViewbox" Stretch="Uniform">
                          <Grid x:Name="HCanvasHost" Width="1600" Height="900" Background="#0E1016">
                            <Image x:Name="HPreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear"/>
                            <Canvas x:Name="HEditLayer" Background="Transparent" ClipToBounds="True"/>
                          </Grid>
                        </Viewbox>
                        <StackPanel x:Name="PreviewPlaceholder" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="460" Margin="0,0,0,18">
                          <TextBlock x:Name="PreviewHint" Text="Start the preview to see the output. Sources can be arranged while it's off."
                                     TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                          <Button x:Name="PreviewButtonCenter" Content="▶  Start preview" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}" Click="Preview_Click"/>
                        </StackPanel>
                      </Grid>
                    </DockPanel>
                    <!-- Vertical canvas (TikTok / Shorts) -->
                    <DockPanel x:Name="VerticalPanel" Grid.Column="3" Margin="12,0,0,0" Visibility="Collapsed">
                      <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="11" Padding="4,2"
                                Click="ResetVertical_Click" ToolTip="Reset to automatic layout"/>
                        <TextBlock x:Name="VerticalCaption" Text="VERTICAL · 9:16" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
                      </DockPanel>
                      <Viewbox x:Name="VViewbox" Stretch="Uniform">
                        <Grid x:Name="VCanvasHost" Width="720" Height="1280" Background="#0E1016">
                          <Image x:Name="VPreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear"/>
                          <Canvas x:Name="VEditLayer" Background="Transparent" ClipToBounds="True"/>
                        </Grid>
                      </Viewbox>
                    </DockPanel>
                  </Grid>
                </Border>
              </ad:LayoutDocument>
            </ad:LayoutDocumentPane>
            <ad:LayoutAnchorablePane DockHeight="78">
              <ad:LayoutAnchorable ContentId="Controls" Title="Controls" CanClose="False" CanHide="True">
                  <DockPanel x:Name="ControlsDock">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                      <Button x:Name="PreviewButton" Content="▶  Preview" Click="Preview_Click" MinWidth="104"/>
                      <Button x:Name="RecordButton" Content="●  Record" Click="Record_Click" MinWidth="104"/>
                      <Button x:Name="VoiceClipsButton" Content="🎙  Voice clips: on" Click="VoiceClipsButton_Click" MinWidth="128"
                              ToolTip="Say the word while live to save a clip. Recent footage is always kept while live."/>
                      <Button x:Name="SettingsButton" Content="⚙  Settings" Click="Settings_Click" MinWidth="104"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Border Style="{StaticResource Chip}" ToolTip="Frames per second (actual / target)">
                        <TextBlock x:Name="StatFps" Text="— FPS" FontSize="12"/>
                      </Border>
                      <Border Style="{StaticResource Chip}" ToolTip="Total upload across live destinations">
                        <TextBlock x:Name="StatNow" Text="↑ —" FontSize="12"/>
                      </Border>
                      <Border Style="{StaticResource Chip}">
                        <TextBlock x:Name="StatHealth" Text="Idle" FontSize="12" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </StackPanel>
                  </DockPanel>
              </ad:LayoutAnchorable>
            </ad:LayoutAnchorablePane>
            <ad:LayoutAnchorablePane DockHeight="300">
              <ad:LayoutAnchorable ContentId="Timer" Title="Timer" CanClose="False" CanHide="True">
                  <Border Style="{StaticResource Card}" Padding="10,8">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="TimerReadout" DockPanel.Dock="Right" Text="00:00" FontSize="30" FontFamily="Consolas"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,2,0"/>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Title shown above the clock" Style="{StaticResource Hint}" Margin="2,0,0,2"/>
                          <TextBox x:Name="TimerTitleBox" Text="SUBATHON" TextChanged="TimerShape_Changed"/>
                        </StackPanel>
                      </DockPanel>
                      <UniformGrid Columns="2" Margin="0,0,0,6">
                        <StackPanel Margin="0,0,4,0">
                          <TextBlock Text="Counts" Style="{StaticResource Hint}" Margin="2,0,0,2"/>
                          <ComboBox x:Name="TimerModeBox" SelectionChanged="TimerShape_Changed">
                            <ComboBoxItem Content="Down to zero"/>
                            <ComboBoxItem Content="Up from zero"/>
                            <ComboBoxItem Content="Clock (time of day)"/>
                          </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                          <TextBlock Text="Length (1:30:00, 25m, 90s)" Style="{StaticResource Hint}" Margin="2,0,0,2"/>
                          <TextBox x:Name="TimerLengthBox" Text="1:00:00" LostFocus="TimerShape_Changed" KeyDown="TimerLength_KeyDown"/>
                        </StackPanel>
                      </UniformGrid>
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="TimerStartButton" Content="▶  Start" Click="TimerStart_Click" MinWidth="92"/>
                        <Button Content="↺  Reset" Click="TimerReset_Click" MinWidth="80"/>
                        <Button Content="+1m" Click="TimerAdd_Click" Tag="60" MinWidth="48"/>
                        <Button Content="+5m" Click="TimerAdd_Click" Tag="300" MinWidth="48"/>
                        <Button Content="+10m" Click="TimerAdd_Click" Tag="600" MinWidth="52"/>
                        <Button Content="−1m" Click="TimerAdd_Click" Tag="-60" MinWidth="48"/>
                      </StackPanel>
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Add to scene" Click="TimerAddSource_Click" MinWidth="104"
                                ToolTip="Puts the timer on the current scene as a source you can drag where you like"/>
                        <CheckBox x:Name="TimerOvertimeBox" Content="Keep counting past zero" VerticalAlignment="Center"
                                  Click="TimerShape_Changed"/>
                      </DockPanel>
                      <TextBlock x:Name="TimerHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="2,6,2,0"
                                 Text="The clock is shared: every Timer source on every scene shows this one."/>
                    </StackPanel>
                  </Border>
              </ad:LayoutAnchorable>
              <ad:LayoutAnchorable ContentId="Mixer" Title="Audio mixer" CanClose="False" CanHide="True">
                  <Border x:Name="MixerDock" Style="{StaticResource Card}" Padding="10,8">
                    <DockPanel>
                      <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                        <TextBlock x:Name="MixerHint" DockPanel.Dock="Right" Text="Up is louder · double-click a fader for 0 dB" Style="{StaticResource Hint}" Margin="0"/>
                        <Button DockPanel.Dock="Left" Content="Balance my audio…" Click="BalanceAudio_Click" HorizontalAlignment="Left" Padding="10,2"
                                ToolTip="A 16-second test (you talk, then the game plays) that sets the microphone and game faders for you"/>
                      </DockPanel>
                      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="MixerList">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border x:Name="Strip" Width="84" Height="226" Margin="0,0,8,2" CornerRadius="10" Padding="6,8,6,6" BorderThickness="1"
                                      BorderBrush="{StaticResource LineBrush}">
                                <Border.Background>
                                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#141A2B" Offset="0"/>
                                    <GradientStop Color="#090C15" Offset="1"/>
                                  </LinearGradientBrush>
                                </Border.Background>
                                <DockPanel>
                                  <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontWeight="{Binding NameWeight}" FontSize="11" HorizontalAlignment="Center"
                                             TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,0,6"/>
                                  <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <Border Background="#05070D" CornerRadius="4" Padding="2,2" Margin="0,0,0,4" BorderThickness="1" BorderBrush="#1A3DD6F5">
                                      <TextBlock Text="{Binding GainText}" FontFamily="Consolas" FontSize="11" Foreground="#9CEBFF" HorizontalAlignment="Center"/>
                                    </Border>
                                    <DockPanel>
                                      <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding Muted}" Style="{StaticResource MuteToggle}" Click="MixerMute_Click" ToolTip="Mute / unmute"/>
                                      <TextBlock Text="{Binding DbText}" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource MutedBrush}"
                                                 HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                  </StackPanel>
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="18"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- dB scale for the meter (0 at the top, -60 at the bottom) -->
                                    <Grid Grid.Column="0" Margin="0,0,3,0">
                                      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                      <TextBlock Grid.Row="0" Text="0" Style="{StaticResource MeterScale}" VerticalAlignment="Top"/>
                                      <TextBlock Grid.Row="1" Text="-12" Style="{StaticResource MeterScale}" VerticalAlignment="Top"/>
                                      <TextBlock Grid.Row="2" Text="-24" Style="{StaticResource MeterScale}" VerticalAlignment="Top"/>
                                      <TextBlock Grid.Row="3" Text="-36" Style="{StaticResource MeterScale}" VerticalAlignment="Top"/>
                                      <TextBlock Grid.Row="4" Text="-48" Style="{StaticResource MeterScale}" VerticalAlignment="Top"/>
                                      <TextBlock Grid.Row="4" Text="-60" Style="{StaticResource MeterScale}" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <local:LedMeter Grid.Column="1" Level="{Binding Meter, Mode=OneWay}" Peak="{Binding Peak, Mode=OneWay}"/>
                                    <Slider Grid.Column="2" Style="{StaticResource FaderSlider}" Minimum="-60" Maximum="20" Value="{Binding Db}" TickFrequency="0.5"
                                            IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="3" MouseDoubleClick="MixerFader_DoubleClick"
                                            ToolTip="Level in dB (double-click for 0 dB)"/>
                                  </Grid>
                                </DockPanel>
                              </Border>
                              <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMaster}" Value="True">
                                  <Setter TargetName="Strip" Property="BorderBrush" Value="#808B7CFF"/>
                                </DataTrigger>
                              </DataTemplate.Triggers>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </DockPanel>
                  </Border>
              </ad:LayoutAnchorable>
            </ad:LayoutAnchorablePane>
          </ad:LayoutPanel>
          <ad:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="320">
            <ad:LayoutAnchorablePane DockHeight="3*">
              <ad:LayoutAnchorable ContentId="Multistream" Title="Multistream" CanClose="False" CanHide="True">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border x:Name="MultistreamDock" Style="{StaticResource Card}">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                          <Button x:Name="StartAllButton" DockPanel.Dock="Right" Content="Start all" Click="StartAll_Click" Padding="10,5" FontSize="12"/>
                        </DockPanel>

                        <TextBlock Text="HORIZONTAL · 16:9" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="2,6,2,2"/>
                        <ItemsControl x:Name="HorizontalOutputs" ItemTemplate="{StaticResource OutputRowTemplate}"/>
                        <TextBlock x:Name="NoHorizontalHint" Text="No horizontal outputs yet." Style="{StaticResource Hint}"/>

                        <DockPanel Margin="2,12,2,2">
                          <CheckBox x:Name="VerticalToggle" DockPanel.Dock="Right" Content="Canvas on" Click="VerticalToggle_Click" Margin="0" FontSize="11"
                                    ToolTip="9:16 canvas for TikTok, Shorts and Reels"/>
                          <TextBlock Text="VERTICAL · 9:16" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl x:Name="VerticalOutputs" ItemTemplate="{StaticResource OutputRowTemplate}"/>
                        <TextBlock x:Name="NoVerticalHint" Text="Add a vertical destination to stream this canvas." Style="{StaticResource Hint}"/>

                        <Button Content="+  Add output" Click="AddOutput_Click" Margin="0,10,0,2" HorizontalAlignment="Stretch"
                                ToolTip="Twitch, YouTube, TikTok, Kick or any RTMP server"/>
                        <TextBlock x:Name="UploadPlanText" Text="" Style="{StaticResource Hint}" Margin="2,6,2,0"/>
                      </StackPanel>
                    </Border>
                  </ScrollViewer>
              </ad:LayoutAnchorable>
              <ad:LayoutAnchorable ContentId="StreamInfo" Title="Stream info" CanClose="False" CanHide="True">
                  <DockPanel x:Name="StreamInfoDock" Margin="4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Click="StreamInfoReload_Click" ToolTip="Reload"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" Click="StreamInfoBrowser_Click" ToolTip="Open in your browser"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="StreamInfoTwitch" Content="Twitch" GroupName="StreamInfo" IsChecked="True" Click="StreamInfoSite_Click" Margin="0,0,12,0"/>
                        <RadioButton x:Name="StreamInfoYouTube" Content="YouTube" GroupName="StreamInfo" Click="StreamInfoSite_Click"/>
                      </StackPanel>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="StreamInfoHint" Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="Sign in once here: it stays signed in. Title, category and tags are saved by Twitch / YouTube."/>
                    <Border x:Name="StreamInfoHost" Background="#05070D" CornerRadius="8"/>
                  </DockPanel>
              </ad:LayoutAnchorable>
            </ad:LayoutAnchorablePane>
            <ad:LayoutAnchorablePane DockHeight="2*">
              <ad:LayoutAnchorable ContentId="SmartStream" Title="Smart stream" CanClose="False" CanHide="True">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border x:Name="SmartStreamDock" Style="{StaticResource Card}">
                      <StackPanel>
                        <TextBlock x:Name="PlanTitle" Text="—" FontSize="14" FontWeight="SemiBold" Margin="2" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PlanSubtitle" Text="" Style="{StaticResource Hint}"/>
                        <TextBlock x:Name="VerticalPlanText" Text="" Style="{StaticResource Hint}" Visibility="Collapsed"/>
                        <TextBlock x:Name="PerformanceText" Text="" Style="{StaticResource Hint}" Foreground="{StaticResource AccentBrush}"
                                   ToolTip="Lighter settings when the PC falls behind (Settings → Connection)"/>
                        <Grid Margin="2,6,2,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                          <TextBlock Text="Average per destination" Foreground="{StaticResource MutedBrush}" Margin="0,3"/>
                          <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StatAvg" Text="—" FontWeight="SemiBold" Margin="0,3"/>
                          <TextBlock Grid.Row="1" Text="Data saved vs. constant bitrate" Foreground="{StaticResource MutedBrush}" Margin="0,3"/>
                          <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StatSaved" Text="—" FontWeight="SemiBold" Foreground="{StaticResource GoodBrush}" Margin="0,3"/>
                          <TextBlock Grid.Row="2" Text="Live time" Foreground="{StaticResource MutedBrush}" Margin="0,3"/>
                          <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StatTime" Text="—" FontWeight="SemiBold" Margin="0,3"/>
                        </Grid>
                        <Button x:Name="ReasonsToggle" Content="Why these settings ▾" Click="ReasonsToggle_Click" HorizontalAlignment="Left"
                                Background="Transparent" BorderBrush="Transparent" Padding="2,4" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                        <ItemsControl x:Name="ReasonsList" Visibility="Collapsed">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding StringFormat='•  {0}'}" Style="{StaticResource Hint}"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </ScrollViewer>
              </ad:LayoutAnchorable>
              <ad:LayoutAnchorable ContentId="Chat" Title="Chat" CanClose="False" CanHide="True">
                  <Border x:Name="ChatHost" Margin="2"/>
              </ad:LayoutAnchorable>
              <ad:LayoutAnchorable ContentId="Activity" Title="Activity" CanClose="False" CanHide="True">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border x:Name="ActivityDock" Style="{StaticResource Card}">
                      <StackPanel>
                        <ItemsControl x:Name="ActivityList">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding}" Style="{StaticResource Hint}"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </ScrollViewer>
              </ad:LayoutAnchorable>
            </ad:LayoutAnchorablePane>
          </ad:LayoutAnchorablePaneGroup>
        </ad:LayoutPanel>
      </ad:LayoutRoot>
    </ad:DockingManager>

    <!-- ===================== Status bar ===================== -->
    <Border Grid.Row="2" Background="#990E1220" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,6">
      <DockPanel>
        <TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" Text="v" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="18,0,0,0"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <StackPanel x:Name="SbRes" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" Background="Transparent">
            <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="SbResText" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Text="—"/>
          </StackPanel>
          <StackPanel x:Name="SbHealth" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" Background="Transparent">
            <Ellipse x:Name="SbHealthDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="SbHealthText" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="SbBitrate" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" Background="Transparent">
            <Ellipse x:Name="SbBitrateDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="SbBitrateText" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="SbEncoder" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" Background="Transparent">
            <Ellipse x:Name="SbEncoderDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="SbEncoderText" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="SbFps" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" Background="Transparent">
            <Ellipse x:Name="SbFpsDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="SbFpsText" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="SbLive" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" Background="Transparent">
            <Ellipse x:Name="SbLiveDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="SbLiveText" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="SbRec" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" Background="Transparent">
            <Ellipse x:Name="SbRecDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="SbRecText" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
        <TextBlock x:Name="EngineStatus" Text="Starting…" Foreground="{StaticResource WarnBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
