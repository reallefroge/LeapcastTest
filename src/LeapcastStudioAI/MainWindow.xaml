<Window x:Class="LeapcastStudioAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leapcast Studio AI" Height="860" Width="1420" MinHeight="600" MinWidth="980"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Grid.Row="0" LastChildFill="True" Margin="4,0,4,12">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="LEAPCAST  /  STUDIO AI" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Smart, low-bandwidth streaming" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Border x:Name="EngineBadge" Background="#332F26" CornerRadius="12" Padding="10,5" Margin="4" VerticalAlignment="Center">
          <TextBlock x:Name="EngineBadgeText" Text="STARTING ENGINE…" Foreground="{StaticResource WarnBrush}" FontSize="11" FontWeight="SemiBold"/>
        </Border>
        <Button Content="Settings" Click="Settings_Click"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="310"/>
      </Grid.ColumnDefinitions>

      <!-- Left: scenes + sources -->
      <Grid Grid.Column="0" Margin="0,0,10,0">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="1.4*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="SCENES" Style="{StaticResource SectionHeader}"/>
            <UniformGrid DockPanel.Dock="Bottom" Columns="3">
              <Button Content="+ Add" Click="AddScene_Click" ToolTip="Add scene"/>
              <Button Content="Rename" Click="RenameScene_Click"/>
              <Button Content="Delete" Click="DeleteScene_Click"/>
            </UniformGrid>
            <ListBox x:Name="ScenesList" SelectionChanged="ScenesList_SelectionChanged"
                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" DisplayMemberPath="Name"/>
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="SOURCES" Style="{StaticResource SectionHeader}" Margin="3,4,3,0"/>
              <TextBlock Text="Lower in the list = drawn on top" Style="{StaticResource Hint}" Margin="3,0,3,6"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
              <UniformGrid Columns="2">
                <Button Content="+ Add source" Click="AddSource_Click"/>
                <Button Content="Properties" Click="SourceProperties_Click"/>
              </UniformGrid>
              <UniformGrid Columns="3">
                <Button Content="▲" Click="MoveSourceUp_Click" ToolTip="Move up the list (further back)"/>
                <Button Content="▼" Click="MoveSourceDown_Click" ToolTip="Move down the list (more in front)"/>
                <Button Content="Remove" Click="RemoveSource_Click"/>
              </UniformGrid>
            </StackPanel>
            <ListBox x:Name="SourcesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                     MouseDoubleClick="SourcesList_MouseDoubleClick" HorizontalContentAlignment="Stretch">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="8,7" Margin="1">
                    <DockPanel>
                      <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Visible}" Click="SourceVisible_Click"
                                VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Show / hide"/>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Type}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Centre: preview + mixer -->
      <Grid Grid.Column="1" Margin="0,0,10,0">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#07080C" BorderBrush="#303646" BorderThickness="1" CornerRadius="12" Padding="8" ClipToBounds="True">
          <Grid>
            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"/>
            <StackPanel x:Name="PreviewPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
              <TextBlock Text="◈" FontSize="54" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="Studio Preview" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
              <TextBlock x:Name="PreviewHint" Text="Start the preview to see your scene exactly as viewers will."
                         TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,10"/>
              <Button x:Name="PreviewButtonCenter" Content="▶  Start preview" HorizontalAlignment="Center" Background="#5748C7" Click="Preview_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
              <Border x:Name="LiveTag" Background="{StaticResource LiveBrush}" CornerRadius="5" Padding="8,3" Margin="0,0,6,0" Visibility="Collapsed">
                <TextBlock x:Name="LiveTagText" Text="LIVE" FontWeight="Bold" FontSize="12"/>
              </Border>
              <Border x:Name="RecTag" Background="#7A2E31" CornerRadius="5" Padding="8,3" Margin="0,0,6,0" Visibility="Collapsed">
                <TextBlock x:Name="RecTagText" Text="● REC" FontWeight="Bold" FontSize="12"/>
              </Border>
              <Border x:Name="ReplayTag" Background="#2E3B7A" CornerRadius="5" Padding="8,3" Visibility="Collapsed">
                <TextBlock Text="REPLAY BUFFER" FontWeight="Bold" FontSize="12"/>
              </Border>
            </StackPanel>
            <TextBlock x:Name="SelectedSceneLabel" Text="" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                       Foreground="#BEB6FF" FontSize="12"/>
          </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="0,10,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="AUDIO MIXER" Style="{StaticResource SectionHeader}" Margin="3,2,0,6"/>
            <TextBlock DockPanel.Dock="Bottom" x:Name="MixerHint" Text="Meters run while the preview or stream is on." Style="{StaticResource Hint}"/>
            <ItemsControl x:Name="MixerList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="3,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Grid.Column="1" Height="10" Minimum="0" Maximum="60" Value="{Binding Meter, Mode=OneWay}" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding DbText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Right: output + smart stats -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="OUTPUT" Style="{StaticResource SectionHeader}" Margin="3,2,0,6"/>
              <TextBlock x:Name="PlanTitle" Text="—" FontSize="14" FontWeight="SemiBold" Margin="3,2" TextWrapping="Wrap"/>
              <TextBlock x:Name="PlanSubtitle" Text="" Style="{StaticResource Hint}" Margin="3,0,3,8"/>
              <Button x:Name="StreamButton" Content="▶  Go live" Background="#5748C7" Click="Stream_Click" FontWeight="SemiBold"/>
              <UniformGrid Columns="2">
                <Button x:Name="RecordButton" Content="●  Record" Click="Record_Click"/>
                <Button x:Name="PreviewButton" Content="Preview" Click="Preview_Click"/>
              </UniformGrid>
              <UniformGrid Columns="2">
                <Button x:Name="ReplayBufferButton" Content="Replay buffer" Click="ReplayBuffer_Click"
                        ToolTip="Keep the last seconds ready to save, even when you're not live"/>
                <Button x:Name="SaveReplayButton" Content="↻  Save replay" Click="Replay_Click"/>
              </UniformGrid>
              <TextBlock x:Name="EngineStatus" Text="Starting…" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" FontSize="11" Margin="4,8,4,2"/>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="SMART STREAM" Style="{StaticResource SectionHeader}" Margin="3,2,0,6"/>
              <Grid Margin="3,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Upload right now" Foreground="{StaticResource MutedBrush}" Margin="0,3"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StatNow" Text="—" FontWeight="SemiBold" Margin="0,3"/>
                <TextBlock Grid.Row="1" Text="Average this stream" Foreground="{StaticResource MutedBrush}" Margin="0,3"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StatAvg" Text="—" FontWeight="SemiBold" Margin="0,3"/>
                <TextBlock Grid.Row="2" Text="Data saved vs. constant bitrate" Foreground="{StaticResource MutedBrush}" Margin="0,3"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StatSaved" Text="—" FontWeight="SemiBold" Foreground="{StaticResource GoodBrush}" Margin="0,3"/>
                <TextBlock Grid.Row="3" Text="Frame rate" Foreground="{StaticResource MutedBrush}" Margin="0,3"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="StatFps" Text="—" FontWeight="SemiBold" Margin="0,3"/>
                <TextBlock Grid.Row="4" Text="Connection health" Foreground="{StaticResource MutedBrush}" Margin="0,3"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="StatHealth" Text="—" FontWeight="SemiBold" Margin="0,3" TextWrapping="Wrap" MaxWidth="150" TextAlignment="Right"/>
                <TextBlock Grid.Row="5" Text="Live time" Foreground="{StaticResource MutedBrush}" Margin="0,3"/>
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="StatTime" Text="—" FontWeight="SemiBold" Margin="0,3"/>
              </Grid>
              <TextBlock Text="WHY THESE SETTINGS" Style="{StaticResource SectionHeader}" Margin="3,12,0,4"/>
              <ItemsControl x:Name="ReasonsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat='•  {0}'}" Style="{StaticResource Hint}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12">
            <StackPanel>
              <TextBlock Text="ACTIVITY" Style="{StaticResource SectionHeader}" Margin="3,2,0,4"/>
              <ItemsControl x:Name="ActivityList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource Hint}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <DockPanel Grid.Row="2" Margin="4,12,4,0">
      <TextBlock x:Name="HardwareLabel" DockPanel.Dock="Left" Text="Detecting hardware…" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
      <TextBlock DockPanel.Dock="Right" Text="v0.4.0 · Windows x64" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </DockPanel>
  </Grid>
</Window>
