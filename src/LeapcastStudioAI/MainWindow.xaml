<Window x:Class="LeapcastStudioAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/leapcast.ico"
        Title="Leapcast Studio AI" Height="900" Width="1520" MinHeight="600" MinWidth="980"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <!-- One multistream output row: status dot, name, live details, start/stop, edit -->
    <DataTemplate x:Key="OutputRowTemplate">
      <Border Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="8,6" Margin="0,3">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" Click="EditOutput_Click" Tag="{Binding Id}" ToolTip="Edit output"/>
          <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Background="{Binding ActionBrush}" Click="ToggleOutput_Click"
                  Tag="{Binding Id}" MinWidth="72" Padding="8,5" FontSize="12"/>
          <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding DotBrush}" Margin="2,0,9,0" VerticalAlignment="Center"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ===================== Top bar ===================== -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="pack://application:,,,/Assets/leapcast-64.png" Width="28" Height="28" Margin="0,0,9,0" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="LEAPCAST" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock Text="STUDIO AI" FontSize="17" Foreground="{StaticResource AccentBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
          <Border x:Name="EngineBadge" Background="#332F26" CornerRadius="10" Padding="9,3" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="EngineBadgeText" Text="STARTING ENGINE…" Foreground="{StaticResource WarnBrush}" FontSize="11" FontWeight="SemiBold"/>
          </Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="LiveTag" Background="{StaticResource LiveBrush}" CornerRadius="6" Padding="9,4" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock x:Name="LiveTagText" Text="LIVE" FontWeight="Bold" FontSize="12"/>
          </Border>
          <Border x:Name="RecTag" Background="#7A2E31" CornerRadius="6" Padding="9,4" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock x:Name="RecTagText" Text="● REC" FontWeight="Bold" FontSize="12"/>
          </Border>
          <Button x:Name="AutoConfigButton" Content="Auto-config" Click="AutoConfig_Click" Padding="12,8" Margin="0,0,6,0"
                  ToolTip="Test this PC with your real scene and pick the smoothest settings (about a minute)"/>
          <Button x:Name="GoLiveButton" Style="{StaticResource PrimaryButton}" Content="▶  Go live" Click="GoLive_Click" Padding="18,8" MinWidth="130"
                  ToolTip="Start every enabled output in the Multistream panel"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="16" Click="Settings_Click" ToolTip="Settings"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===================== Body ===================== -->
    <Grid Grid.Row="1" Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="244"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="310"/>
      </Grid.ColumnDefinitions>

      <!-- Left: scenes + sources -->
      <Grid Grid.Column="0" Margin="0,0,10,0">
        <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE710;" Click="AddScene_Click" ToolTip="Add scene (copies the current one)"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8AC;" Click="RenameScene_Click" ToolTip="Rename scene"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="DeleteScene_Click" ToolTip="Delete scene"/>
              </StackPanel>
              <TextBlock Text="SCENES" Style="{StaticResource SectionHeader}" Margin="2,0" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="Click a scene to switch with a smooth transition." Style="{StaticResource Hint}"/>
            <ListBox x:Name="ScenesList" SelectionChanged="ScenesList_SelectionChanged" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextBrush}" DisplayMemberPath="Name"/>
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE710;" Click="AddSource_Click" ToolTip="Add source"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="SourceProperties_Click" ToolTip="Properties"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Click="MoveSourceUp_Click" ToolTip="Send backward"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Click="MoveSourceDown_Click" ToolTip="Bring forward"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="RemoveSource_Click" ToolTip="Remove source"/>
              </StackPanel>
              <TextBlock Text="SOURCES" Style="{StaticResource SectionHeader}" Margin="2,0" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="Lower in the list = in front. Drag sources on the preview to move them; drag a corner or edge to resize (Shift: stretch, Ctrl+Shift: crop); 🔒 locks one in place; right-click for more."
                       Style="{StaticResource Hint}"/>
            <ListBox x:Name="SourcesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                     MouseDoubleClick="SourcesList_MouseDoubleClick" SelectionChanged="SourcesList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Visible}" Click="SourceVisible_Click"
                              VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Show / hide"/>
                    <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding Locked}" Click="SourceLock_Click" Style="{StaticResource LockToggle}"
                                  VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Lock: prevent moving and resizing on the preview"/>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Type}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Centre: canvases + controls + mixer -->
      <Grid Grid.Column="1" Margin="0,0,10,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#07080C" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="StageColumn" Width="0"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="3.2*"/>
              <ColumnDefinition x:Name="VerticalColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <!-- Studio mode: the staged scene (editable) -->
            <DockPanel x:Name="StagePanel" Grid.Column="0" Visibility="Collapsed">
              <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                <TextBlock x:Name="StageSceneLabel" DockPanel.Dock="Right" Text="" Foreground="#BEB6FF" FontSize="12" Margin="8,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="PREVIEW" Style="{StaticResource SectionHeader}" Margin="0" ToolTip="Arrange the next scene here; nothing changes on air until you click Transition"/>
              </DockPanel>
              <Viewbox x:Name="SViewbox" Stretch="Uniform">
                <Grid x:Name="SCanvasHost" Width="1600" Height="900" Background="#0E1016">
                  <Image x:Name="SPreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear"/>
                  <Canvas x:Name="SEditLayer" Background="Transparent" ClipToBounds="True"/>
                </Grid>
              </Viewbox>
            </DockPanel>
            <StackPanel x:Name="TransitionPanel" Grid.Column="1" VerticalAlignment="Center" Margin="10,0" Visibility="Collapsed" Width="118">
              <Button x:Name="TransitionButton" Content="Transition ➜" Style="{StaticResource PrimaryButton}" Click="Transition_Click"
                      ToolTip="Put the Preview scene on air (Program)" Padding="8,9"/>
              <ComboBox x:Name="TransitionKindBox" Margin="0,8,0,0" SelectionChanged="TransitionKind_SelectionChanged" ToolTip="How the scene switch looks">
                <ComboBoxItem Content="Fade · 0.3 s" Tag="Fade|300"/>
                <ComboBoxItem Content="Fade · 0.6 s" Tag="Fade|600"/>
                <ComboBoxItem Content="Fade · 1 s" Tag="Fade|1000"/>
                <ComboBoxItem Content="Fade · 2 s" Tag="Fade|2000"/>
                <ComboBoxItem Content="Cut" Tag="Cut|0"/>
              </ComboBox>
            </StackPanel>
            <!-- Horizontal canvas (Program in studio mode) -->
            <DockPanel Grid.Column="2">
              <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                <TextBlock x:Name="SelectedSceneLabel" DockPanel.Dock="Right" Text="" Foreground="#BEB6FF" FontSize="12" Margin="8,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="HorizontalCaption" Text="HORIZONTAL · 16:9" Style="{StaticResource SectionHeader}" Margin="0" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <Grid>
                <Viewbox x:Name="HViewbox" Stretch="Uniform">
                  <Grid x:Name="HCanvasHost" Width="1600" Height="900" Background="#0E1016">
                    <Image x:Name="HPreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear"/>
                    <Canvas x:Name="HEditLayer" Background="Transparent" ClipToBounds="True"/>
                  </Grid>
                </Viewbox>
                <StackPanel x:Name="PreviewPlaceholder" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="460" Margin="0,0,0,18">
                  <TextBlock x:Name="PreviewHint" Text="Start the preview to see your scene exactly as viewers will. You can arrange sources even while it's off."
                             TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                  <Button x:Name="PreviewButtonCenter" Content="▶  Start preview" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}" Click="Preview_Click"/>
                </StackPanel>
              </Grid>
            </DockPanel>
            <!-- Vertical canvas (TikTok / Shorts) -->
            <DockPanel x:Name="VerticalPanel" Grid.Column="3" Margin="12,0,0,0" Visibility="Collapsed">
              <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="11" Padding="4,2"
                        Click="ResetVertical_Click" ToolTip="Reset the vertical layout to automatic (camera on top, game below)"/>
                <TextBlock x:Name="VerticalCaption" Text="VERTICAL · 9:16" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
              </DockPanel>
              <Viewbox x:Name="VViewbox" Stretch="Uniform">
                <Grid x:Name="VCanvasHost" Width="720" Height="1280" Background="#0E1016">
                  <Image x:Name="VPreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear"/>
                  <Canvas x:Name="VEditLayer" Background="Transparent" ClipToBounds="True"/>
                </Grid>
              </Viewbox>
            </DockPanel>
          </Grid>
        </Border>

        <!-- control strip -->
        <DockPanel Grid.Row="1" Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
            <Button x:Name="PreviewButton" Content="▶  Preview" Click="Preview_Click" MinWidth="104"/>
            <Button x:Name="RecordButton" Content="●  Record" Click="Record_Click" MinWidth="104"/>
            <Button x:Name="ReplayBufferButton" Content="Replay buffer" Click="ReplayBuffer_Click"
                    ToolTip="Keep the last seconds ready to save, even when you're not live"/>
            <Button x:Name="SaveReplayButton" Content="Save replay" Click="Replay_Click" ToolTip="Save the last seconds as a clip"/>
            <Button x:Name="StudioModeButton" Content="Studio mode" Click="StudioMode_Click"
                    ToolTip="Preview the next scene (and edit it) beside what's on air, then click Transition"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border Style="{StaticResource Chip}" ToolTip="Frames per second (actual / planned)">
              <TextBlock x:Name="StatFps" Text="— FPS" FontSize="12"/>
            </Border>
            <Border Style="{StaticResource Chip}" ToolTip="Total upload right now, across every live destination">
              <TextBlock x:Name="StatNow" Text="↑ —" FontSize="12"/>
            </Border>
            <Border Style="{StaticResource Chip}">
              <TextBlock x:Name="StatHealth" Text="Idle" FontSize="12" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
            </Border>
          </StackPanel>
        </DockPanel>

        <!-- mixer -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="10,6">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="AUDIO" Style="{StaticResource SectionHeader}" Margin="2,4,12,0" VerticalAlignment="Top"/>
            <TextBlock DockPanel.Dock="Bottom" x:Name="MixerHint" Text="Meters run while the preview or stream is on." Style="{StaticResource Hint}"/>
            <ItemsControl x:Name="MixerList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="3,3,12,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="60" Value="{Binding Meter, Mode=OneWay}" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding DbText}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Right: multistream dock (Aitum-style) + smart stats -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <Button x:Name="StartAllButton" DockPanel.Dock="Right" Content="Start all" Click="StartAll_Click" Padding="10,5" FontSize="12"/>
                <TextBlock Text="MULTISTREAM" Style="{StaticResource SectionHeader}" Margin="2,0" VerticalAlignment="Center"/>
              </DockPanel>

              <TextBlock Text="HORIZONTAL · 16:9" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="2,6,2,2"/>
              <ItemsControl x:Name="HorizontalOutputs" ItemTemplate="{StaticResource OutputRowTemplate}"/>
              <TextBlock x:Name="NoHorizontalHint" Text="No horizontal outputs yet." Style="{StaticResource Hint}"/>

              <DockPanel Margin="2,12,2,2">
                <CheckBox x:Name="VerticalToggle" DockPanel.Dock="Right" Content="Canvas on" Click="VerticalToggle_Click" Margin="0" FontSize="11"
                          ToolTip="A second 9:16 canvas for TikTok, YouTube Shorts and Instagram"/>
                <TextBlock Text="VERTICAL · 9:16" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <ItemsControl x:Name="VerticalOutputs" ItemTemplate="{StaticResource OutputRowTemplate}"/>
              <TextBlock x:Name="NoVerticalHint" Text="Add a TikTok output to stream the vertical canvas." Style="{StaticResource Hint}"/>

              <Button Content="+  Add output" Click="AddOutput_Click" Margin="0,10,0,2" HorizontalAlignment="Stretch"
                      ToolTip="Twitch, YouTube, TikTok, Kick or any RTMP server"/>
              <TextBlock x:Name="UploadPlanText" Text="" Style="{StaticResource Hint}" Margin="2,6,2,0"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="SMART STREAM" Style="{StaticResource SectionHeader}" Margin="2,0,0,6"/>
              <TextBlock x:Name="PlanTitle" Text="—" FontSize="14" FontWeight="SemiBold" Margin="2" TextWrapping="Wrap"/>
              <TextBlock x:Name="PlanSubtitle" Text="" Style="{StaticResource Hint}"/>
              <TextBlock x:Name="VerticalPlanText" Text="" Style="{StaticResource Hint}" Visibility="Collapsed"/>
              <TextBlock x:Name="PerformanceText" Text="" Style="{StaticResource Hint}" Foreground="{StaticResource AccentBrush}"
                         ToolTip="Leapcast steps to lighter settings when this PC falls behind, and back up when it has headroom (Settings → Connection)."/>
              <Grid Margin="2,6,2,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Average per destination" Foreground="{StaticResource MutedBrush}" Margin="0,3"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StatAvg" Text="—" FontWeight="SemiBold" Margin="0,3"/>
                <TextBlock Grid.Row="1" Text="Data saved vs. constant bitrate" Foreground="{StaticResource MutedBrush}" Margin="0,3"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StatSaved" Text="—" FontWeight="SemiBold" Foreground="{StaticResource GoodBrush}" Margin="0,3"/>
                <TextBlock Grid.Row="2" Text="Live time" Foreground="{StaticResource MutedBrush}" Margin="0,3"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StatTime" Text="—" FontWeight="SemiBold" Margin="0,3"/>
              </Grid>
              <Button x:Name="ReasonsToggle" Content="Why these settings ▾" Click="ReasonsToggle_Click" HorizontalAlignment="Left"
                      Background="Transparent" BorderBrush="Transparent" Padding="2,4" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
              <ItemsControl x:Name="ReasonsList" Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat='•  {0}'}" Style="{StaticResource Hint}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="ACTIVITY" Style="{StaticResource SectionHeader}" Margin="2,0,0,4"/>
              <ItemsControl x:Name="ActivityList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource Hint}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ===================== Status bar ===================== -->
    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,5">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="v0.8.0 · Windows x64" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock x:Name="HardwareLabel" DockPanel.Dock="Right" Text="Detecting hardware…" Foreground="{StaticResource MutedBrush}" FontSize="11"
                   VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
        <TextBlock x:Name="EngineStatus" Text="Starting…" Foreground="{StaticResource WarnBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
