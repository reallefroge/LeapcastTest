<Window x:Class="LeapcastStudioAI.SourcePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/leapcast.ico"
        Title="Add source" Height="640" Width="460" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="BackButton" Content="Back" Click="Back_Click" Visibility="Collapsed"/>
      <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
      <Button x:Name="AddButton" Content="Next" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
    </StackPanel>

    <Grid>
      <!-- step 1: what kind of source -->
      <ScrollViewer x:Name="TypePage" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Choose source type" FontSize="17" FontWeight="SemiBold" Margin="3,0,0,8"/>
          <ListBox x:Name="SourceType" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                   HorizontalContentAlignment="Stretch" MouseDoubleClick="SourceType_MouseDoubleClick" SelectionChanged="SourceType_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10,7" Margin="1">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Have}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,2,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </ScrollViewer>

      <!-- step 2: a new one, or one you already have (any scene, this one too) -->
      <DockPanel x:Name="ChoicePage" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock x:Name="ChoiceHeader" Text="Add" FontSize="17" FontWeight="SemiBold" Margin="3,0,0,10"/>
          <RadioButton x:Name="NewRadio" Content="Make a new one" GroupName="pick" IsChecked="True" FontWeight="SemiBold" Margin="3,0,0,6" Click="NewRadio_Click"/>
          <TextBox x:Name="NewName" Margin="24,0,0,4" TextChanged="NewName_TextChanged"/>
          <TextBlock Text="You set it up next (device, window, page…)." Style="{StaticResource Hint}" Margin="24,0,0,14"/>
          <RadioButton x:Name="ExistingRadio" Content="Add one you already have" GroupName="pick" FontWeight="SemiBold" Margin="3,0,0,2" Click="ExistingRadio_Click"/>
          <TextBlock x:Name="ExistingHint" Text="The same source with every setting (device, crop, size, filters, hotkey): nothing to set up again." Style="{StaticResource Hint}" Margin="24,0,0,8" TextWrapping="Wrap"/>
        </StackPanel>
        <ListBox x:Name="ExistingList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" Margin="20,0,0,0"
                 HorizontalContentAlignment="Stretch" MouseDoubleClick="ExistingList_MouseDoubleClick" SelectionChanged="ExistingList_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10,7" Margin="1">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
