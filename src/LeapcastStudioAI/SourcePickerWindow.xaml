<Window x:Class="LeapcastStudioAI.SourcePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/leapcast.ico"
        Title="Add source" SizeToContent="Height" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
  <StackPanel Margin="18">
    <TextBlock Text="Choose source type" FontSize="17" FontWeight="SemiBold" Margin="3,0,0,8"/>
    <ListBox x:Name="SourceType" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
             HorizontalContentAlignment="Stretch" MouseDoubleClick="SourceType_MouseDoubleClick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10,7" Margin="1">
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Add source" IsDefault="True" Background="#5748C7" Click="Add_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
