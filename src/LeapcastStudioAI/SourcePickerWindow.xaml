<Window x:Class="LeapcastStudioAI.SourcePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/leapcast.ico"
        Title="Add source" Height="640" Width="460" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
      <Button x:Name="AddButton" Content="Add source" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- sources already set up in other scenes: added as a copy with every setting -->
        <StackPanel x:Name="ExistingGroup">
          <TextBlock Text="Add one you already set up" FontSize="17" FontWeight="SemiBold" Margin="3,0,0,2"/>
          <TextBlock Text="Copies every setting." Style="{StaticResource Hint}" Margin="3,0,0,8"/>
          <ListBox x:Name="ExistingList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                   HorizontalContentAlignment="Stretch" MouseDoubleClick="SourceType_MouseDoubleClick" SelectionChanged="ExistingList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10,7" Margin="1">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="Or add a new one" FontSize="17" FontWeight="SemiBold" Margin="3,16,0,8"/>
        </StackPanel>
        <TextBlock x:Name="NewHeader" Text="Choose source type" FontSize="17" FontWeight="SemiBold" Margin="3,0,0,8"/>
        <ListBox x:Name="SourceType" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                 HorizontalContentAlignment="Stretch" MouseDoubleClick="SourceType_MouseDoubleClick" SelectionChanged="SourceType_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10,7" Margin="1">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
